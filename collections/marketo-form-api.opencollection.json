                "description": "id"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Status filter for draft or approved versions"
              }
            ]
          },
          "docs": "Retrieves a form record by its id. Required Permissions: Read-Only Assets, Read-Write Assets"
        },
