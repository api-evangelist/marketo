          "http": {
            "method": "GET",
            "url": "https://localhost:8080/rest/asset/v1/landingPage/:id/dynamicContent/:contentId.json",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Id of landing page"
              },
              {
                "name": "contentId",
                "value": "",
                "type": "path",
                "description": "Id of landing page dynamic content section"
              }
            ]
